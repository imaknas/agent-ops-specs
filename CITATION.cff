    given-names: Knas
    orcid: "https://orcid.org/0009-0007-0414-2355"
repository-code: "https://github.com/imaknas/agent-ops-specs"
url: "https://imaknas.github.io/agent-ops-specs/"
license: Apache-2.0
keywords:
  - AI agents
  - human oversight
  - delegation
  - protocol specification
