{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence/schemas/evidence.schema.json",
  "title": "Principal Handoff Evidence 0.5: evidence members",
  "description": "The members of a record's evidence that the Evidence module defines (evidence section 2). A record that breaks this schema stays valid; a verifier ignores its verifiable and verified.",
  "type": "object",
  "properties": {
    "verifiable": {
      "description": "Independently verifiable proofs of facts (evidence section 2). Each entry carries exactly one of proof and proof_ref.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "format",
          "statement"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "format": {
            "type": "string",
            "pattern": "^\\S{1,128}$"
          },
          "statement": {
            "type": "string",
            "pattern": "\\S"
          },
          "proof": {
            "type": "string",
            "pattern": "\\S"
          },
          "proof_ref": {
            "type": "object",
            "required": [
              "uri",
              "digest"
            ],
            "properties": {
              "uri": {
                "type": "string",
                "pattern": "\\S"
              },
              "digest": {
                "type": "string",
                "pattern": "^sha-256:[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "verified": {
      "description": "What the principal side checked (evidence section 2); on settlements and principal-side notes only.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "of",
          "verifier",
          "result",
          "at"
        ],
        "properties": {
          "of": {
            "type": "object",
            "required": [
              "record",
              "entry"
            ],
            "properties": {
              "record": {
                "type": "string",
                "pattern": "^\\S{1,256}$"
              },
              "entry": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
              },
              "origin": {
                "description": "The origin of the record checked; without it, every record about the item with that id.",
                "type": "string",
                "pattern": "^[a-z][a-z_]*$"
              }
            }
          },
          "verifier": {
            "type": "string",
            "pattern": "^\\S{1,256}$"
          },
          "result": {
            "type": "string",
            "enum": [
              "valid",
              "invalid",
              "unsupported"
            ]
          },
          "at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?([Zz]|[+-][0-9]{2}:[0-9]{2})$"
          }
        }
      }
    }
  }
}
