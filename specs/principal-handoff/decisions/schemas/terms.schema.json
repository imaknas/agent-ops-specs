{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "decisions/schemas/terms.schema.json",
  "title": "Principal Handoff Decisions 0.4: terms",
  "description": "The terms of a decision (decisions section 2); referenced by raised and amended.",
  "type": "object",
  "required": [
    "text"
  ],
  "properties": {
    "text": {
      "type": "string",
      "pattern": "\\S"
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^\\S{1,64}$"
          },
          "label": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      }
    },
    "default": {
      "type": "string",
      "pattern": "\\S"
    },
    "due": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "criteria": {
      "description": "Acceptance criteria the principal may approve (decisions section 2.1).",
      "type": "object",
      "required": [
        "subject",
        "checks",
        "answer"
      ],
      "properties": {
        "subject": {
          "type": "object",
          "required": [
            "uri",
            "digest"
          ],
          "properties": {
            "uri": {
              "type": "string",
              "pattern": "\\S"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha-256:[0-9a-f]{64}$"
            }
          }
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "text",
              "format",
              "implementation",
              "trust"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
              },
              "text": {
                "type": "string",
                "pattern": "\\S"
              },
              "format": {
                "type": "string",
                "pattern": "^\\S{1,128}$"
              },
              "implementation": {
                "type": "object",
                "required": [
                  "uri",
                  "digest"
                ],
                "properties": {
                  "uri": {
                    "type": "string",
                    "pattern": "\\S"
                  },
                  "digest": {
                    "type": "string",
                    "pattern": "^sha-256:[0-9a-f]{64}$"
                  }
                }
              },
              "trust": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "\\S"
                }
              }
            }
          }
        },
        "answer": {
          "type": "object",
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string",
              "pattern": "\\S"
            },
            "option": {
              "type": "string",
              "pattern": "^\\S{1,64}$"
            }
          }
        }
      }
    }
  }
}
