{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "decisions/schemas/terms.schema.json",
  "title": "Principal Handoff Decisions 0.6: terms",
  "description": "The terms of a decision (decisions section 2); referenced by raised and amended. Modules add members (Criteria: criteria).",
  "type": "object",
  "required": [
    "text"
  ],
  "properties": {
    "text": {
      "type": "string",
      "pattern": "\\S"
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^\\S{1,64}$"
          },
          "label": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      }
    },
    "default": {
      "type": "string",
      "pattern": "\\S"
    },
    "due": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    }
  }
}
