{
  "suite": "acts/0.4",
  "description": "Registrar step 4: holding lines whose normalised text differs from the latest terms -> amended items; holding lines that disagree -> warnings.",
  "cases": [
    {
      "id": "edited-keyed-line",
      "profile": "en",
      "document": [
        "## Tasks",
        "- [ ] [owner] Renew the domain for two years (waiting on owner: task-demo-aaaaaaaaaa)"
      ],
      "latest": {
        "task-demo-aaaaaaaaaa": "Renew the domain"
      },
      "expect": {
        "amended": [
          {
            "key": "task-demo-aaaaaaaaaa",
            "text": "Renew the domain for two years"
          }
        ],
        "warn": []
      }
    },
    {
      "id": "whitespace-only-change",
      "profile": "en",
      "document": [
        "## Tasks",
        "- [ ] [owner] Renew  the   domain (waiting on owner: task-demo-aaaaaaaaaa)"
      ],
      "latest": {
        "task-demo-aaaaaaaaaa": "Renew the domain"
      },
      "expect": {
        "amended": [],
        "warn": []
      }
    },
    {
      "id": "unknown-key-ignored",
      "profile": "en",
      "document": [
        "## Tasks",
        "- [ ] [owner] Something else (waiting on owner: task-demo-bbbbbbbbbb)"
      ],
      "latest": {
        "task-demo-aaaaaaaaaa": "Renew the domain"
      },
      "expect": {
        "amended": [],
        "warn": []
      }
    },
    {
      "id": "zh-edited",
      "profile": "zh-hant",
      "document": [
        "## 待辦",
        "- [ ] 〔Owner〕續約網域兩年(等 Owner:task-demo-aaaaaaaaaa)"
      ],
      "latest": {
        "task-demo-aaaaaaaaaa": "續約網域"
      },
      "expect": {
        "amended": [
          {
            "key": "task-demo-aaaaaaaaaa",
            "text": "續約網域兩年"
          }
        ],
        "warn": []
      }
    },
    {
      "id": "relabelled-line-not-amended",
      "profile": "en",
      "document": [
        "## Tasks",
        "- [ ] [agent] Renew the domain for two years (waiting on owner: task-demo-aaaaaaaaaa)"
      ],
      "latest": {
        "task-demo-aaaaaaaaaa": "Renew the domain"
      },
      "expect": {
        "amended": [],
        "warn": []
      }
    },
    {
      "id": "copied-marker-warns",
      "profile": "en",
      "document": [
        "## Tasks",
        "- [ ] [owner] Renew the domain (waiting on owner: task-demo-aaaaaaaaaa)",
        "- [ ] [owner] Sign the contract (waiting on owner: task-demo-aaaaaaaaaa)"
      ],
      "latest": {
        "task-demo-aaaaaaaaaa": "Renew the domain"
      },
      "expect": {
        "amended": [],
        "warn": [
          "task-demo-aaaaaaaaaa"
        ]
      }
    },
    {
      "id": "second-section-not-amended",
      "profile": "en",
      "document": [
        "## Tasks",
        "- [ ] [agent] Other",
        "## Tasks",
        "- [ ] [owner] Renew the domain for two years (waiting on owner: task-demo-aaaaaaaaaa)"
      ],
      "latest": {
        "task-demo-aaaaaaaaaa": "Renew the domain"
      },
      "expect": {
        "amended": [],
        "warn": []
      }
    },
    {
      "id": "amended-text-is-normalised",
      "profile": "en",
      "document": [
        "## Tasks",
        "- [ ] [owner] Renew   the domain  now (waiting on owner: task-demo-aaaaaaaaaa)"
      ],
      "latest": {
        "task-demo-aaaaaaaaaa": "Renew the domain"
      },
      "expect": {
        "amended": [
          {
            "key": "task-demo-aaaaaaaaaa",
            "text": "Renew the domain now"
          }
        ],
        "warn": []
      }
    }
  ]
}
