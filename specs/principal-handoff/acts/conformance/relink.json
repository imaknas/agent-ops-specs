{
  "suite": "acts/0.4",
  "description": "Registrar step 2: an unkeyed principal line whose normalised text equals the latest terms of a vanished open key gets that key back.",
  "cases": [
    {
      "id": "relinked",
      "profile": "en",
      "document": [
        "## Tasks",
        "- [ ] [owner] Renew the domain"
      ],
      "active": {
        "task-demo-aaaaaaaaaa": "Renew  the domain"
      },
      "expect": {
        "relinked": [
          "task-demo-aaaaaaaaaa"
        ],
        "document": [
          "## Tasks",
          "- [ ] [owner] Renew the domain (waiting on owner: task-demo-aaaaaaaaaa)"
        ]
      }
    },
