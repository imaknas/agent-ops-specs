{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reopened.schema.json",
  "title": "Principal Handoff Acts 0.3: reopened",
  "description": "Principal side -> requester's project: an earlier settlement no longer stands.",
  "$ref": "../../core/schemas/record.schema.json",
  "required": [
    "supersedes"
  ],
  "properties": {
    "ext": {
      "const": "acts/0.3"
    },
    "type": {
      "const": "reopened"
    },
    "origin": {
      "const": "principal"
    },
    "restore_text": {
      "type": "string",
      "pattern": "\\S"
    }
  }
}
